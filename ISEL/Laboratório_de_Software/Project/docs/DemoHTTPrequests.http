@baseUrl = http://localhost:8080
# Copy token from User 1 response and paste below
@myToken = f5525ddc-369c-4d4c-b90d-a8a5a4e6faf3

### ─────────────────────────────────────
### 6.1 - Create User 1
### ─────────────────────────────────────
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Alice",
  "email": "alice@example.com"
}

### ─────────────────────────────────────
### 6.1 - Create User 2
### ─────────────────────────────────────
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Bob",
  "email": "bob@example.com"
}

### ─────────────────────────────────────
### 6.2 - Create User with duplicate email (should return 409)
### ─────────────────────────────────────
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Alice2",
  "email": "alice@example.com"
}

### ─────────────────────────────────────
### 6.3 - Create Location: Portugal (COUNTRY)
### ─────────────────────────────────────

POST {{baseUrl}}/locations
Authorization: Bearer {{myToken}}
Content-Type: application/json

{
  "name": "Portugal",
  "type": "COUNTRY"
}

### ─────────────────────────────────────
### 6.3 - Create Location: Lisboa (REGION, parent = Portugal id=1)
### ─────────────────────────────────────
POST {{baseUrl}}/locations
Authorization: Bearer {{myToken}}
Content-Type: application/json

{
  "name": "Lisboa",
  "type": "REGION",
  "parentId": 1
}

### ─────────────────────────────────────
### 6.3 - Create Location: Oeiras (CITY, parent = Lisboa id=2)
### ─────────────────────────────────────
POST {{baseUrl}}/locations
Authorization: Bearer {{myToken}}
Content-Type: application/json

{
  "name": "Oeiras",
  "type": "CITY",
  "parentId": 2
}

### ─────────────────────────────────────
### 6.3 - Create Location: Paço de Arcos (MUNICIPALITY, parent = Oeiras id=3)
### ─────────────────────────────────────
POST {{baseUrl}}/locations
Authorization: Bearer {{myToken}}
Content-Type: application/json

{
  "name": "Paço de Arcos",
  "type": "MUNICIPALITY",
  "parentId": 3
}

### ─────────────────────────────────────
### 6.4 - List children of Lisboa (id=2)
### ─────────────────────────────────────
GET {{baseUrl}}/locations/2/children

