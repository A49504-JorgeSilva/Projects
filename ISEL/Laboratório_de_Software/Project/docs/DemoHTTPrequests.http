### ─────────────────────────────────────
### 6.9 - Invalid date format (should return 400)
### ─────────────────────────────────────
POST {{baseUrl}}/bookings
Authorization: Bearer {{myToken}}
Content-Type: application/json

{
  "hid": 1,
  "startDate": "not-a-date",
  "endDate": "2026-07-20"
}

### ─────────────────────────────────────
### 6.9 - Overlapping booking (should return 409)
### ─────────────────────────────────────
POST {{baseUrl}}/bookings
Authorization: Bearer {{myToken}}
Content-Type: application/json

{
  "hid": 1,
  "startDate": "2026-07-03",
  "endDate": "2026-07-12"
}

### ─────────────────────────────────────
### 6.10 - List all bookings for house 1
### ─────────────────────────────────────
GET {{baseUrl}}/bookings?hid=1
Authorization: Bearer {{myToken}}

### ─────────────────────────────────────
### 6.11 - Show details of booking 1
### ─────────────────────────────────────
GET {{baseUrl}}/bookings/1
Authorization: Bearer {{myToken}}

### ─────────────────────────────────────
### 6.12 - List houses with pagination (page size 2) - Page 1
### ─────────────────────────────────────
GET {{baseUrl}}/houses?skip=0&limit=2

### ─────────────────────────────────────
### 6.12 - Page 2
### ─────────────────────────────────────
GET {{baseUrl}}/houses?skip=2&limit=2

### ─────────────────────────────────────
### 6.12 - Page 3 (should return empty list - end of results)
### ─────────────────────────────────────
GET {{baseUrl}}/houses?skip=4&limit=2

### ─────────────────────────────────────
### 6.13 - Delete booking 2
### ─────────────────────────────────────
DELETE {{baseUrl}}/bookings/2
Authorization: Bearer {{myToken}}

### ─────────────────────────────────────
### 6.14 - Show deleted booking (should return 404)
### ─────────────────────────────────────
GET {{baseUrl}}/bookings/2
Authorization: Bearer {{myToken}}